rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(boatId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/boats/$(boatId)/members/$(request.auth.uid));
    }
    function role(boatId) {
      return get(/databases/$(database)/documents/boats/$(boatId)/members/$(request.auth.uid)).data.role;
    }
    function canEdit(boatId) { return member(boatId) && role(boatId) in ['owner', 'editor']; }
    function owner(boatId) { return member(boatId) && role(boatId) == 'owner'; }

    match /boats/{boatId} {
      allow read: if member(boatId);
      allow create, delete: if false;
      allow update: if owner(boatId);
      match /members/{uid} {
        allow read: if member(boatId);
        allow create, update, delete: if owner(boatId)
          && uid != request.auth.uid
          && request.resource.data.keys().hasOnly(['role'])
          && request.resource.data.role in ['editor', 'viewer'];
      }
      match /{collection}/{docId} {
        allow read: if member(boatId) &&
          collection in ['equipment','faults','services','tasks','parts','documents'];
        allow create, update, delete: if canEdit(boatId) &&
          collection in ['equipment','faults','services','tasks','parts','documents'];
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
